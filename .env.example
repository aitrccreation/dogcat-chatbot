# Dog and Cat Lovely — Environment Variables
# Copy เป็น .env แล้วใส่ค่าจริง (อย่า commit ไฟล์นี้ขึ้น GitHub!)

# บอทลูกค้า (@dogcatlovely) — รับ webhook + ตอบลูกค้า
LINE_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE
LINE_SECRET=YOUR_LINE_CHANNEL_SECRET_HERE

# บอทแจ้งเตือน admin — LINE_TARGET_ID คือ user ID ของผู้รับ (ดูที่ Basic settings → Your user ID)
LINE_TARGET_ID=YOUR_LINE_USER_ID_HERE
LOVELY_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE

# บอทสำรอง — ใช้เมื่อบอทหลักส่งครบโควตารายเดือน (แผนฟรี 300 ข้อความ/เดือน)
# ถ้าอยู่ provider เดียวกับบอทหลัก user ID จะเหมือนกัน ไม่ต้องตั้ง LINE_TARGET_ID2
LOVELY_BOT2_TOKEN=YOUR_BACKUP_ADMIN_BOT_TOKEN_HERE
# LINE_TARGET_ID2=ตั้งเฉพาะเมื่อบอทสำรองอยู่คนละ provider

FB_TOKEN=YOUR_FB_PAGE_ACCESS_TOKEN_HERE
FB_VERIFY=dogcatlovely_verify_2026

# Optional
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
FLASK_DEBUG=false

# DRX local MySQL (read-only — ใช้ดึงข้อมูล OPD ทั้งหมดมาวิเคราะห์)
DRX_DB_HOST=localhost
DRX_DB_PORT=3306
DRX_DB_NAME=drxvet_db_5_0_dogandcat
DRX_DB_USER=root
DRX_DB_PASSWORD=YOUR_MYSQL_ROOT_PASSWORD
